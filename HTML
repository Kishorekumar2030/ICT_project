<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Class Rep Voting</title>
</head>

<body>

    <h1>Class Representative Election</h1>

    <!-- 1. SETUP -->

    <div>

        <h2>Election Setup</h2>

        <label>
            Class Size:
            <input type="number" id="classSize" min="2"
                   placeholder="Enter class size">
        </label>

        <br><br>

        <label>
            Candidate Name:
            <input type="text" id="candName"
                   placeholder="Enter candidate name">
        </label>

        <button>Add Candidate</button>

        <h3>Registered Candidates</h3>

        <ul>
        </ul>

        <button>Start Voting</button>

    </div>


    <!-- 2. VOTING -->

    <div>

        <h2>Voting Section</h2>

        <h3>Round 1</h3>

        <p>Votes cast: 0</p>

        <br>

        <button>Finish and Count Votes</button>

    </div>


    <!-- 3. WINNER -->

    <div>

        <h2>Election Winner</h2>

        <h1>Winner Name</h1>

        <h3>Final Results</h3>

        <button>New Election</button>

    </div>

</body>

</html>
