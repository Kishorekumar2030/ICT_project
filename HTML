<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Class Rep Voting</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <h1>Class Representative Election</h1>

    <!-- 1. SETUP -->

    <div id="setupSection" class="box">

        <h2>Election Setup</h2>

        <label>
            Class Size:
            <input type="number" id="classSize" min="2"
                   placeholder="Enter class size">
        </label>

        <br><br>

        <label>
            Candidate Name:
            <input type="text" id="candName"
                   placeholder="Enter candidate name">
        </label>

        <button onclick="addCandidate()">Add Candidate</button>

        <h3>Registered Candidates</h3>

        <ul id="candList">
        </ul>

        <button onclick="startVoting()">Start Voting</button>

    </div>


    <!-- 2. VOTING -->

    <div id="votingSection" class="box" style="display: none;">

        <h2>Voting Section</h2>

        <h3 id="roundText">Round 1</h3>

        <p id="voteText">Votes cast: 0</p>

        <div id="voteButtons"></div>

        <br>

        <button onclick="countVotes()">Finish and Count Votes</button>

    </div>


    <!-- 3. WINNER -->

    <div id="winnerSection" class="box" style="display: none;">

        <h2>Election Winner</h2>

        <h1 id="winnerName">Winner Name</h1>

        <h3>Final Results</h3>

        <ul id="resultsList"></ul>

        <button onclick="newElection()">New Election</button>

    </div>

    <script src="script.js"></script>

</body>

</html>
